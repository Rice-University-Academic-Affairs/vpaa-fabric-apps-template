{
	"name": "@vpaa/ui",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"admin:generate": "tsx scripts/generate-admin.ts",
		"admin:check": "tsx scripts/generate-admin.ts check",
		"predev": "npm run admin:generate",
		"prebuild": "npm run admin:generate",
		"dev": "cross-env PUBLIC_ADMIN_TEST_MODE=true vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && svelte-package",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
		"test": "vitest run && tsx --test scripts/generator.node.test.ts",
		"test:unit": "vitest run",
		"test:generator": "tsx --test scripts/generator.node.test.ts",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:smoke": "playwright test -c playwright.smoke.config.ts",
		"test:e2e": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./theme.css": "./src/lib/styles/theme.css",
		"./utils": "./src/lib/utils.ts",
		"./components/*": "./src/lib/components/*",
		"./ai-chat/*": "./src/lib/ai-chat/*",
		"./hooks/*": "./src/lib/hooks/*",
		"./types/*": "./src/lib/types/*",
		"./admin/components/*": "./src/lib/admin/components/*"
	},
	"peerDependencies": {
		"@lucide/svelte": "^1.0.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@microsoft/rayfin-auth": "catalog:",
		"@microsoft/rayfin-auth-provider-fabric": "catalog:",
		"@microsoft/rayfin-client": "catalog:",
		"@microsoft/rayfin-core": "catalog:",
		"@microsoft/rayfin-data": "catalog:",
		"@microsoft/rayfin-lib": "catalog:",
		"@tanstack/ai": "^0.43.0",
		"@tanstack/ai-client": "^0.23.3",
		"@tanstack/ai-svelte": "^0.16.0",
		"@tanstack/svelte-table": "^9.0.0",
		"@vpaa/auth": "workspace:*",
		"@vpaa/data": "workspace:*",
		"@vpaa/types": "workspace:*",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.3.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@lucide/svelte": "catalog:",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/svelte": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"cross-env": "catalog:",
		"jsdom": "catalog:",
		"playwright": "catalog:",
		"publint": "^0.3.21",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"keywords": [
		"svelte"
	]
}
