{
	"name": "{{packageName}}",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"admin:generate": "tsx scripts/generate-admin.ts",
		"admin:check": "tsx scripts/generate-admin.ts check",
		"predev": "npm run admin:generate",
		"prebuild": "npm run admin:generate",
		"dev": "cross-env PUBLIC_ADMIN_TEST_MODE=true vite dev",
		"dev:frontend": "vite dev",
		"dev:rayfin": "rayfin dev",
		"build": "vite build",
		"build:fabric": "npm run admin:generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:smoke": "playwright test -c playwright.smoke.config.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "catalog:",
		"@microsoft/rayfin-client": "catalog:",
		"@microsoft/rayfin-connectors": "catalog:",
		"@microsoft/rayfin-core": "catalog:",
		"@vpaa/auth": "workspace:*",
		"@vpaa/config": "workspace:*",
		"@vpaa/data": "workspace:*",
		"@vpaa/types": "workspace:*",
		"@vpaa/admin": "workspace:*",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.3.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@microsoft/rayfin-cli": "catalog:",
		"@microsoft/rayfin-local-dev": "catalog:",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"cross-env": "catalog:",
		"jsdom": "catalog:",
		"playwright": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
